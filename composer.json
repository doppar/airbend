{
    "name": "doppar/airbend",
    "description": "Doppar Airbend is a real-time broadcasting component of the Doppar PHP Framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mahedi Hasan",
            "email": "mahedy150101@gmail.com"
        }
    ],
    "require": {
        "predis/predis": "^3.3",
        "workerman/channel": "^1.2",
        "workerman/workerman": "^5.1"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^13.3",
        "doppar/framework": "4.*"
    },
    "autoload": {
        "psr-4": {
            "Doppar\\Airbend\\": "src/"
        },
        "files": [
            "src/Helpers/broadcast.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Doppar\\Airbend\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
